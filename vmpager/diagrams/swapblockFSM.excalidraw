    {
      "id": "aH-Agw5A22df6t-SSRjYM",
      "type": "text",
      "x": 1708.464173716608,
      "y": -187.17040818605233,
      "width": 931.8956909179688,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 367312121,
      "version": 1001,
      "versionNonce": 572452439,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1730094486728,
      "link": null,
      "locked": false,
      "text": "valid is 1 because i literally just made the page it better be valid\nresident is 1 because if i make a page, it is made in physical memory\ntherefore it is valid\ndirty is 0 because I just made the page\nref is 1 becasue i just made the page\n\nppage: 0(?) referencing the pinned page to do the \"create on write\"\nrbit is 1 because i can read -> no need to trap to OS\nwbit is 0 because if i want to write -> trap to OS so i can actually \nmake a new page and not reference the pinned page\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "valid is 1 because i literally just made the page it better be valid\nresident is 1 because if i make a page, it is made in physical memory\ntherefore it is valid\ndirty is 0 because I just made the page\nref is 1 becasue i just made the page\n\nppage: 0(?) referencing the pinned page to do the \"create on write\"\nrbit is 1 because i can read -> no need to trap to OS\nwbit is 0 because if i want to write -> trap to OS so i can actually \nmake a new page and not reference the pinned page\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
